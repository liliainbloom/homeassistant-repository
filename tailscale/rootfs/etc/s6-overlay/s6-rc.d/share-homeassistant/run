#!/command/with-contenv bashio
# shellcheck shell=bash
export LOG_FD
# ==============================================================================
# Home Assistant Community App: Tailscale
# Enables Tailscale Serve or Funnel feature to share Home Assistant
# ==============================================================================

readonly WAIT_DELAY=5   # 5s
readonly WAIT_COUNT=18  # 18*5s = 90s = 1.5m
readonly TAILSCALE_CLI="${TAILSCALE_CLI:-/opt/tailscale}"

declare wait_counter=0
declare curl_result
declare forwarded_curl_result

declare curl_protocol
declare tailscale_protocol
declare -a curl_options
declare -a tailscale_options

# A permanent validation failure happens before this longrun would normally
# report readiness. Mark it ready first so s6-rc stops restarting it while the
# finish script shuts the container down.
share_homeassistant::notify_ready() {
  echo "" >&3
  exec 3>&-
}

share_homeassistant::exit_nok() {
  share_homeassistant::notify_ready
  bashio::exit.nok "$*"
}

# curl writes "000" for connection failures, but still exits non-zero. Capture
# that status without letting bashio's errexit handling terminate the service.
share_homeassistant::http_status() {
  local status

  if ! status="$(curl "$@")"; then
    status="${status:-000}"
  fi

  if [[ ! "${status}" =~ ^[0-9]{3}$ ]]; then
    status="000"
  fi

  printf '%s' "${status}"
}

# Validate share_homeassistant value
if ! bashio::config.equals 'share_homeassistant' 'serve' && \
  ! bashio::config.equals 'share_homeassistant' 'funnel'
then
  share_homeassistant::exit_nok "Invalid value '$(bashio::config 'share_homeassistant')' for share_homeassistant. Must be either 'serve' or 'funnel'"
fi

# Check if Tailscale HTTPS is enabled
if ! "${TAILSCALE_CLI}" status --self=true --peers=false --json \
  | jq -rce '.Self.CapMap | has("https")' > /dev/null;
then
  share_homeassistant::exit_nok \
    "Tailscale's HTTPS support is disabled." \
    "Please check your configuration based on the app's documentation under \"Option: share_homeassistant\"."
fi

# Check if Funnel is available
if bashio::config.equals 'share_homeassistant' 'funnel'; then
  if ! "${TAILSCALE_CLI}" status --self=true --peers=false --json \
    | jq -rce '.Self.CapMap | has("funnel")' > /dev/null;
  then
    share_homeassistant::exit_nok \
      "Tailscale's Funnel support is disabled." \
      "Please check your configuration based on the app's documentation under \"Option: share_homeassistant\"."
  fi
fi

curl_options+=(-s)
curl_options+=(-o/dev/null)
curl_options+=(-w"%{http_code}")

tailscale_options+=("$(bashio::config 'share_homeassistant')")
tailscale_options+=(--bg=false)
tailscale_options+=(--https="$(bashio::config 'share_on_port')")
tailscale_options+=(--set-path=/)

# Checking if SSL is used
if bashio::var.true "$(bashio::core.ssl)"; then
  bashio::log.notice \
    "Home Assistant is using SSL, Tailscale will connect to Home Assistant locally through HTTPS," \
    "that unnecessarily uses resources and slows down the communication."
  curl_protocol="https"
  curl_options+=(-k)
  tailscale_protocol="https+insecure"
else
  curl_protocol="http"
  tailscale_protocol="http"
fi
curl_options+=("${curl_protocol}://127.0.0.1:$(bashio::core.port)")
tailscale_options+=("${tailscale_protocol}://127.0.0.1:$(bashio::core.port)")

# Wait a bit for HA to be available during startup
while true; do
  curl_result="$(share_homeassistant::http_status "${curl_options[@]}")"
  if [[ "${curl_result}" == "200" ]]; then
    break
  fi

  if (( wait_counter++ == WAIT_COUNT )); then
    break
  fi
  bashio::log.info "Waiting for Home Assistant to be ready..."
  sleep $WAIT_DELAY
done
if (( wait_counter != 0 )) && [[ "${curl_result}" == "200" ]]; then
  bashio::log.info "Home Assistant is ready"
fi

if [[ "${curl_result}" != "200" ]]; then
  # Warn that we can't test Home Assistant's HTTP/HTTPS reverse proxy configuration
  # We emit only a warning to let the app start, maybe this is the only connection to access the device, better to start than not
  # Though starting tailscale serve without HA won't fail, but will fill the logs with messages forever in each ~10s
  bashio::log.warning \
    "Home Assistant is not accessible currently (HTTP status ${curl_result});" \
    "unable to test the reverse-proxy connection"
else
  # Test Home Assistant's HTTP/HTTPS reverse proxy configuration
  curl_options+=(-H "X-Forwarded-For: 127.0.0.1")
  forwarded_curl_result="$(share_homeassistant::http_status "${curl_options[@]}")"
  if [[ "${forwarded_curl_result}" != "200" ]]; then
    if [[ "${forwarded_curl_result}" == "400" ]]; then
      share_homeassistant::exit_nok \
        "Home Assistant rejected the reverse-proxy test (HTTP 400)." \
        "In Settings > System > Network > HTTP server > Reverse proxy," \
        "enable Trust X-Forwarded-For, add 127.0.0.1 to Trusted proxies," \
        "and confirm the pending HTTP configuration after Home Assistant restarts."
    fi

    share_homeassistant::exit_nok \
      "Unable to connect to Home Assistant as reverse proxy (HTTP status ${forwarded_curl_result})." \
      "Please check your configuration based on the app's documentation under \"Option: share_homeassistant\"."
  fi
fi

# This service can wait for HA for minutes, let notify S6 when we are really starting
share_homeassistant::notify_ready

# Set up serve or funnel
exec "${TAILSCALE_CLI}" "${tailscale_options[@]}"
